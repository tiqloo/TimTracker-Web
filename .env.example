# Copy to .env.local and fill in real values (gitignored, never commit it).
#
# DEFAULT (since Phase 1b, 2026-08-25): point this at the LOCAL Docker
# Supabase stack from TimTracker-Starter (`supabase start`, from that
# repo), not production — see this repo's README.md ("`.env.local`: lokal
# gegen Docker (Standard), Produktion nur gezielt") for the full reasoning
# and pre-confirmed local seed users. `supabase start`'s output prints the
# API_URL/PUBLISHABLE_KEY values to use below.
#
# Same Supabase project (and same values) as the TimTracker-Starter
# (macOS/Windows) apps when pointed at production instead — that's the
# project's Resources/Config.xcconfig. Only use production values here for
# a deliberate, temporary, one-off check (e.g. production-only auth
# behavior); switch back to local afterward.
#
# NEVER put the Supabase secret key here — this is a browser-exposed
# client. Server-only secrets belong in Vercel's server-side env vars,
# never in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=CHANGE-ME

# This site's own base URL — used as the Supabase password-reset
# redirect target (lib/repositories/supabase/auth.repository.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public macOS release. Keep all five values empty until the exact artifact has
# passed signing, notarization and the release smoke test. The website only
# enables its download buttons when the complete, valid set is configured.
NEXT_PUBLIC_MACOS_DOWNLOAD_URL=
NEXT_PUBLIC_MACOS_APP_VERSION=
NEXT_PUBLIC_MACOS_MIN_VERSION=
NEXT_PUBLIC_MACOS_FILE_SIZE=
NEXT_PUBLIC_MACOS_SHA256=
